# PHC-X environment configuration (copy to .env)
# Privacy defaults: local processing only, telemetry OFF.

# Local API
PHC_HOST=127.0.0.1
PHC_PORT=8000

# Data directory (all processing is local by default)
PHC_DATA_DIR=./data

# Telemetry is OFF by default. Never upload conversation content.
PHC_TELEMETRY=0

# Optional: external LLM endpoint for generation experiments (leave empty for offline/demo mode)
PHC_LLM_BASE_URL=
PHC_LLM_MODEL=

# Optional: Ollama local endpoint used only if explicitly enabled
PHC_OLLAMA_URL=http://127.0.0.1:11434

# Retention (days) for locally stored conversations; 0 = keep forever
PHC_RETENTION_DAYS=30
