# PHC-X environment configuration (copy to .env)
# Privacy defaults: local processing only.  PHC-X never makes network calls
# at runtime and has no telemetry.

# ---------------------------------------------------------------- API service
# These are the variables the FastAPI service actually reads.
# The checkpoint is auto-discovered under ./checkpoints/ when PHCX_MODEL is unset.
#PHCX_MODEL=checkpoints/phcx_train_baseline_seed42/model
#PHCX_POLICY=configs/policy.yaml
#PHCX_LOG=data/decision_log.jsonl
#PHCX_RESULTS=results/raw

# ------------------------------------------------------------------- adapters
# Optional: external LLM endpoint for generation experiments (leave empty for offline/demo mode)
PHC_LLM_BASE_URL=
PHC_LLM_MODEL=
OPENAI_API_KEY=

# Optional: Ollama local endpoint used only if explicitly enabled
PHC_OLLAMA_URL=http://127.0.0.1:11434
PHC_OLLAMA_MODEL=llama3.2:3b

# Optional: local HuggingFace model for white-box signals
#PHC_LOCAL_MODEL=meta-llama/Llama-3.2-1B

# Optional: local NLI model used as an *additional* verification signal
#PHC_NLI_MODEL=cross-encoder/nli-deberta-v3-small
